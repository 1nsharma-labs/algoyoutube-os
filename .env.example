# AlgoYouTube OS Environment Configuration Template
# Copy to .env for local development

PORT=4000
WEB_PORT=3000
API_URL=http://127.0.0.1:4000

# Security: 32-Byte Secret for AES-256-GCM Token Encryption
ALGOYOUTUBE_MASTER_SECRET=algoyoutube-master-offline-key-change-in-prod

# Optional Free-Tier Cloud AI (Zero Mandatory Subscriptions)
GEMINI_API_KEY=

# Local LLM Runtime (Ollama / vLLM / llama.cpp)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional YouTube Data API v3 Key (Public RSS is used as free fallback)
YOUTUBE_API_KEY=

# Optional GitHub Token for PR creation & commit inspection
GITHUB_TOKEN=
