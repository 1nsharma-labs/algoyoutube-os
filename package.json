{
  "name": "algoyoutube-os-monorepo",
  "version": "1.0.0",
  "description": "AlgoYouTube OS — Autonomous AI Engineering & Self-Evolving Creator Intelligence Ecosystem",
  "private": true,
  "workspaces": [
    "packages/*",
    "engines/*",
    "connectors/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/index.test.mjs",
    "lint": "node --check apps/api/src/index.mjs apps/web/server.mjs packages/*/src/index.mjs engines/*/src/index.mjs connectors/*/src/index.mjs",
    "benchmark": "node -e \"import('@algoyoutube/engine-benchmark').then(async b => console.log(await b.benchmarkEngine.runSuite()));\"",
    "audit:security": "node -e \"import('@algoyoutube/security').then(s => console.log('SSRF Boundary Defense:', !s.validateSafeUrl('http://169.254.169.254').safe ? 'PASSED' : 'FAILED'));\"",
    "verify:servers": "node tests/verify-servers.mjs",
    "verify:web": "node tests/verify-web.mjs",
    "dev:api": "node apps/api/src/index.mjs",
    "dev:web": "node apps/web/server.mjs",
    "start": "node apps/api/src/index.mjs"
  },
  "keywords": [
    "creator-economy",
    "youtube-automation",
    "mcp",
    "model-context-protocol",
    "multi-agent",
    "self-evolving",
    "open-source"
  ],
  "author": "1nsharma (1nsharma-labs)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
